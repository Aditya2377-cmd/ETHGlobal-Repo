# =================================================================
# PerPay Gateway (FastAPI) Environment Configuration
# =================================================================

# Server Port
PORT=8000

# Groq API Key (Obtain from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# SQLite Ledger Path
SQLITE_DB=gateway_ledger.db

# Shared Secret for Service-to-Service Internal Communication
INTERNAL_SERVICE_SECRET=perpay-internal-secret-2026

# Hedera Network & Receiver
HEDERA_NETWORK=testnet
HEDERA_RECEIVER_ACCOUNT_ID=0.0.9999999
TREASURY_ACCOUNT_ID=0.0.9999999

# Platform Spending & Rate Limits
MAX_OUTPUT_TOKENS=2048
DAILY_GROQ_BUDGET_USD=25.0
MAX_UNPAID_INVOICES_PER_USER=1


# =================================================================
# PerPay x402 Hedera Payment Service Environment Configuration
# =================================================================

# Server Port
PORT=4020

# Hedera Network (Must be hedera:testnet - Mainnet is strictly rejected)
HEDERA_NETWORK=hedera:testnet

# Application Receiving Account (Public 0.0.x format - NEVER put private keys here)
HEDERA_RECEIVER_ACCOUNT_ID=0.0.9999999

# Hosted or Local x402 Facilitator URL
FACILITATOR_URL=https://x402.org/facilitator

# Authoritative FastAPI Gateway URL
FASTAPI_GATEWAY_URL=http://localhost:8000

# Shared Secret for Service-to-Service Internal Communication
INTERNAL_SERVICE_SECRET=perpay_internal_secret_replace_in_production

# Hedera Mirror Node Base URL
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# SQLite Local Database Storage Path
SQLITE_DB_PATH=./data/perpay_payments.db

# Payment Validity Window in Seconds (Default: 120s)
MAX_PAYMENT_TIMEOUT_SECONDS=120

# =================================================================
# OPTIONAL: Testnet Smoke Test Credentials (CLI Testing Only)
# NEVER commit real keys or include .env in Git!
# =================================================================
# TESTNET_SMOKE_PAYER_ID=0.0.YOUR_TESTNET_ACCOUNT_ID
# TESTNET_SMOKE_PAYER_KEY=YOUR_DER_OR_HEX_TESTNET_PRIVATE_KEY

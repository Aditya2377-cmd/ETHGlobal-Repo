{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerPaySharedEvent",
  "description": "Authoritative versioned shared event across FastAPI, x402 payment engine, and Pawan's dashboard",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "request_id",
    "invoice_id",
    "generation_id",
    "user_id",
    "model",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens",
    "charge_tinybars",
    "charge_hbar",
    "network",
    "payment_scheme",
    "payment_status",
    "delivery_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0.0"]
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "generation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "wallet": {
      "type": ["string", "null"],
      "pattern": "^0\\.0\\.[1-9][0-9]*$"
    },
    "model": {
      "type": "string"
    },
    "prompt_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "completion_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "charge_tinybars": {
      "type": "integer",
      "minimum": 1
    },
    "charge_hbar": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    },
    "network": {
      "type": "string",
      "enum": ["hedera:testnet"]
    },
    "payment_scheme": {
      "type": "string",
      "enum": ["exact"]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "PAYMENT_REQUIRED",
        "PAYMENT_SUBMITTED",
        "VERIFYING",
        "SETTLING",
        "SETTLEMENT_PENDING",
        "RECONCILIATION_REQUIRED",
        "CONFIRMED",
        "FAILED",
        "EXPIRED"
      ]
    },
    "transaction_id": {
      "type": ["string", "null"],
      "pattern": "^0\\.0\\.[0-9]+-[0-9]+-[0-9]+$"
    },
    "transaction_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "AWAITING_PAYMENT",
        "DELIVERED",
        "DELIVERY_FAILED",
        "EXPIRED"
      ]
    }
  },
  "additionalProperties": false
}

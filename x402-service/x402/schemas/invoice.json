{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerPayTrustedInvoiceContext",
  "description": "Authoritative invoice context provided by FastAPI gateway to x402 payment engine",
  "type": "object",
  "required": [
    "invoice_id",
    "generation_id",
    "request_id",
    "user_id",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens",
    "charge_tinybars",
    "charge_hbar",
    "model",
    "status",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "generation_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "prompt_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "completion_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "charge_tinybars": {
      "type": "integer",
      "minimum": 1
    },
    "charge_hbar": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["UNPAID", "PAID", "EXPIRED", "CANCELLED"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

{
  "name": "perpay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:gateway": "python -m uvicorn gateway.main:app --host 127.0.0.1 --port 8000",
    "dev:x402": "npm --prefix x402-service run dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/perpay.test.mjs",
    "test:frontend": "node --test tests/perpay.test.mjs",
    "test:gateway": "python -m unittest gateway/tests/test_payper_backend.py",
    "test:x402": "npm --prefix x402-service test"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
